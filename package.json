{
  "name": "bcommend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0 <25" },
  "scripts": {
    "dev": "wrangler dev --config apps/api/wrangler.jsonc --local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config apps/api/wrangler.jsonc",
    "dev:session": "node scripts/create-local-session.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build-api.mjs",
    "test:local": "node scripts/smoke-local.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.4",
    "@cloudflare/workers-types": "5.20260907.1",
    "@types/node": "22.15.17",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.129.0"
  }
}
